{
  // --- General Waybar Settings ---
  "position": "top",
  "layer": "bottom",
  "margin-top": 3,
  "margin-bottom": 2,
  "margin-left": 10,
  "margin-right": 10,
  "height" : 38,

  // --- Module Layout ---

  "modules-left": ["wireplumber", "hyprland/workspaces"],
  "modules-center": ["battery", "clock", "backlight"],
  "modules-right": ["custom/netspeed", "bluetooth", "custom/notifications", "network", "custom/power"],

  // --- Module Definitions ---

  "hyprland/workspaces": {
    "format": "{windows}", 
    "format-window-separator": "",
    "on-click": "activate",
    "disable-scroll": true,
    "workspace-taskbar": {
        "enable": true,
        "update-active-window": true,
        "format": "{icon}",
        // "icon-theme": "Adwaita",
        "icon-size": 24,
        "on-click-window": "~/.config/scripts/waybar-focus-window.sh {address} {button}"
    }
  },
  
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon}   {volume}%",
    "format-muted": " Mute",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", ""]
    },
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.5%-",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 0.1,
    "ignored-sinks": ["Easy Effects Sink"]
  },

  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip": false
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "scroll-step": 0.2
  },

  "battery": {
    "states": {
      "good": 50,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon}  {capacity}%",
    "format-icons": ["","","","","","","","","",""],
    "tooltip": true
  },

  "network": {
    "format": "{ifname}",
    "format-icons":["󰤟","󰤢","󰤥","󰤨"],
    "format-wifi": "{icon}   {essid} ({signalStrength}%)",
    "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    "format-disconnected": "󰤮   Not-connected",
    "format-disabled": "󰤮   Off",
    "max-length": 50
  },

  "bluetooth": {
    // "format": "󰂯 {status}",
    "format-on": "󰂯 On",
    "format-off": "󰂯 Off",
    "format-connected": "󰂯 {device_alias}",
    "format-connected-battery": " {device_alias} ({device_battery_percentage}%)",
    "on-click": "blueman-manager"
  },

  "custom/notifications": {
    "format": "", 
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },

  "custom/netspeed": {
    "format": "{}",
    "tooltip": false,
    "exec": "~/.config/scripts/custom-netspeed.sh",
    "interval": 1
  }
}
