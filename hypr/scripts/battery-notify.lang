[META]
# Telugu slang, 5 best lines each.

[UNPLUGGED]
MSG_1=Battery at %%, charger theesesav raa… ippudu battery meeda brathike time.
MSG_2=Battery at %%, ayyo unplug ayyindi… ippudu jagratta undu hero.
MSG_3=Battery at %%, current poyindi… nenu ippudu self-respect mode lo unnanu.
MSG_4=Battery at %%, jaagrathaga vaadu raa.
MSG_5=Battery at %%, cable thisinaav raa.

[PLUGGED_IN]
MSG_1=Battery at %%, charger pettav… bagundi.
MSG_2=Battery at %%, power ochindi… lappy ippudu full josh lo undi.
MSG_3=Battery at %%, ippudu recharge mode lo…
MSG_4=Battery at %%, current attach ayyindi… lappy ki santosham ekkuva.
MSG_5=Battery at %%, cable vesav ga, energy boost start ayyindi.

[LOW_20]
MSG_1=Battery at %%, ayyayyo… ippude charger vethuku ra bhayya.
MSG_2=Battery at %%, early warning raa idhi.
MSG_3=Battery at %%, ippude connect cheyyali… lekapothe kashtam.
MSG_4=Battery at %%, warning ichesthunna… vintava?
MSG_5=Battery at %%, ippude outlet ekkado choosi pettu.

[LOW_15]
MSG_1=Battery at %%, antey last few mins raa… charge pettu.
MSG_2=Battery at %%, ippudu pettalevu antey off ayina na meeda blame cheyaku.
MSG_3=Battery at %%, ippude urgent ga charging kavali.
MSG_4=Battery at %%, danger gurinchi cheppanu… ippude respond avvu.
MSG_5=Battery at %%, em peekuthunnav raa, charging pettu ra.

[LOW_10]
MSG_1=Battery at %%, arey… em kastam vachindhi ra? charging pettu raa.
MSG_2=Battery at %%, ippude pettakapothe very soon ga aagipothadi ra.
MSG_3=Battery at %%, last moments ra babu.
MSG_4=Battery at %%, ultra low… ekkuva risk.
MSG_5=Battery at %%, charging pettu raa vedava.

[CRITICAL]
MSG_1=Battery at %%, ippudu immediate ga charge pettali—no excuses.
MSG_2=Battery at %%, eppudu off aipothano naakkuda teliyadu.
MSG_3=Battery at %%, last warning… ippude pettu.
MSG_4=Battery at %%, survival mode lo undi… emi cheyyalo telusu kada?
MSG_5=Battery at %%, charging pettu raa howle.

[UNPLUG_80]
MSG_1=Battery reached %%, ide sweet spot… unplug cheyyi.
MSG_2=Battery reached %%, battery ki ide healthy level raa.
MSG_3=Battery reached %%, ippudu teesthe baaguntundi.
MSG_4=Battery reached %%, chalu… charger remove cheyyi.
MSG_5=Battery reached %%, ekkuva charge avvakunda brake ivvu.

[UNPLUG_85]
MSG_1=Battery reached %%, inga chalu ra… ippudu cable unplug chey.
MSG_2=Battery reached %%, battery “inka chaalu” antundi.
MSG_3=Battery reached %%, ippude unplug chesthe battery ki life ekkuva.
MSG_4=Battery reached %%, remove cheyyi ra brother.
MSG_5=Battery reached %%, saripoyindi… unplug cheyyi bey.

[UNPLUG_90]
MSG_1=Battery reached %%, chala ekkuva ayindi… inka enduku raa?
MSG_2=Battery reached %%, almost full raa… unplug cheyyi.
MSG_3=Battery reached %%, ippude teesthe baaguntadhi ra bayya.
MSG_4=Battery reached %%, ekkuva chesthe bore avthundi.
MSG_5=Battery reached %%, battery feelings hurt avvakunda chuda ra.

[UNPLUG_95]
MSG_1=Battery reached %%, inka chalu raa naayana. unplug chey.
MSG_2=Battery reached %%, almost complete—unplug cheyyi raa.
MSG_3=Battery reached %%, thiyyi raa inga, enthasepu raa?
MSG_4=Battery reached %%, inka 5% kosam wait chesthunnavara? unplug chey raa.
MSG_5=Battery reached %%, unplug chey raa, battery ki kastam avutundi raa ikkada.

[UNPLUG_100]
MSG_1=Battery reached %%, full ayindi raa… unplug chey.
MSG_2=Battery reached %%, full full full full full.
MSG_3=Battery reached %%, cycle complete—inka avasaram ledu raa.
MSG_4=Battery reached %%, cord remove cheyyi boss.
MSG_5=Battery reached %%, enduku inka charger petti torture chesthunav? unplug chey raa.
